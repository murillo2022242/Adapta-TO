{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vpath=/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?__vpath=/uploads/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__vpath=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__vpath=/sitemap.xml"
    },
    {
      "source": "/((?!assets/|src/|api/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
